{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "German"
        ],
        "displayLanguageSelector": true
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "FrameStudio",
        "width": 1440,
        "height": 980,
        "minWidth": 1000,
        "minHeight": 650,
        "backgroundColor": "#f6f4ef"
      }
    ]
  }
}
