{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FrameStudio",
  "version": "0.3.0",
  "identifier": "com.yorkstack.framestudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FrameStudio",
        "width": 1440,
        "height": 980,
        "minWidth": 1000,
        "minHeight": 720,
        "backgroundColor": "#f6f4ef"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Lokale Grafikwerkstatt",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/THIRD_PARTY_NOTICES.txt",
      "resources/OFL.txt",
      "resources/LICENSE"
    ]
  }
}
